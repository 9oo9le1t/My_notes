     1.Очистка системного кэша и пакетов

sudo apt autoremove --purge  # удалит ненужные зависимости
sudo apt clean               # очистит архив скачанных установщиков

     2.Очистка старых версий Snap

set -eu
snap list --all | awk '/disabled/{print $1, $3}' |
    while read snapname revision; do
        sudo snap remove "$snapname" --revision="$revision"
    done

     3.Очистка логов (журналов)

sudo journalctl --vacuum-size=100M

     4.Очистка кэша эскизов (Thumbnail cache)

rm -rf ~/.cache/thumbnails/*
